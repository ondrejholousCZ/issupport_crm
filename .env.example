# --- Databáze ---
DATABASE_URL=postgresql://crmissp:<PASSWORD>@resvm1.issupport.cz:5432/apireg?options=-c%20search_path%3Dcrmissp
DATABASE_SSL=false

# --- NextAuth / Auth.js ---
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generovat: openssl rand -base64 32>

# --- Entra ID (Enterprise App — stejný tenant jako FaktuMatch, jiná App Registration) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Vercel Cron ---
CRON_SECRET=<generovat: openssl rand -base64 32>

# --- DAIS Open API — lookup firmy podle IČO ---
DAIS_API_BASE_URL=https://resvm1.issupport.cz:8443/api/v1
DAIS_API_KEY=
# DAIS_API_TLS_REJECT_UNAUTHORIZED=true

# --- SendGrid (výkazy práce — schvalování) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=IS Support s. r. o.

# --- iDoklad (fakturace) ---
IDOKLAD_CLIENT_ID=
IDOKLAD_CLIENT_SECRET=
# Volitelně: ID výchozí číselné řady pro vydané faktury (jinak se dohledá automaticky)
# IDOKLAD_NUMERIC_SEQUENCE_ID=

# --- Azure File Storage (PDF faktur pro FaktuMatch) ---
# DŮLEŽITÉ: jde o File share (.file.core.windows.net), NE blob (.blob.core.windows.net).
# Stejné údaje jako ve FaktuMatchu — lze použít buď CRM názvy, nebo FaktuMatch aliasy.
AZURE_STORAGE_ACCOUNT=pgrisspfaktumatch
AZURE_STORAGE_ACCESS_KEY=
AZURE_STORAGE_FILE_SHARE=faktury
# Alternativně (stejné hodnoty jako ve fakturacni_asistent):
# AZURE_FILES_ACCOUNT=pgrisspfaktumatch
# AZURE_FILES_KEY=
# AZURE_FILES_SHARE=faktury
# Volitelně — File endpoint (NEPOUŽÍVAT blob URL!)
# AZURE_STORAGE_FILE_ENDPOINT=https://pgrisspfaktumatch.file.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=pgrisspfaktumatch;AccountKey=...;EndpointSuffix=core.windows.net
# Ve Vercelu SMAZAT: AZURE_STORAGE_CONTAINER (blob — neplatí pro file share)

# --- Budoucí napojení na FaktuMatch (fáze 3) ---
# FAKTUMATCH_API_URL=""
# FAKTUMATCH_API_KEY=""
